# SREE Virtual Assistant Configuration
# Copy this file to .env and fill in your values

# Security
SREE_PASSWORD=your_secure_password_here

# Features
USE_AI=false
OPENAI_API_KEY=your_openai_api_key_here

# Logging
LOG_LEVEL=INFO
DEBUG=false

# Voice Settings
VOICE_RATE=175
VOICE_VOLUME=1.0

# Microphone Settings
MICROPHONE_TIMEOUT=6
PHRASE_TIME_LIMIT=6

# Speech Recognition
SPEECH_LANGUAGE=en-IN

# Optional: WhatsApp Integration
WHATSAPP_ENABLED=false
